{
  "name": "@bomsquad/site",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "codegen": "node tools/generate-db-types.mjs",
    "stage-data": "node tools/stage-data-assets.mjs",
    "prestart": "npm run codegen && npm run stage-data",
    "start": "ng serve",
    "prebuild": "npm run codegen && npm run stage-data",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "typecheck": "ng build --configuration development --output-path=.tsc-check && rm -rf .tsc-check"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "jsdom": "^30.0.1",
    "typescript": "6.0.3",
    "vitest": "^4.0.8"
  },
  "description": "BOM Squad Angular SPA, deployed to Azure Static Web Apps.",
  "license": "MIT"
}
