# Dependencies
node_modules/

# Build outputs — everything under dist/ is generated; only .gitkeep is tracked.
# `dist/*` contains a slash, so it is anchored to this directory and covers the root
# dist/ only; each workspace's own outDir needs its own line.
dist/*
!dist/.gitkeep
# README.md is documentation, not a build output. Without this negation `dist/*`
# swallows it and a fresh clone has no record of the directory's edit policy at all,
# which is the one thing T0.1 requires every directory to carry.
!dist/README.md
pipeline/dist/

# Download / extraction cache (large MAME artifacts). `pipeline mame:fetch` writes the
# verified listxml archive here, keyed by release; nothing in it is ever committed.
.cache/

# Angular
site/.angular/
site/dist/

# Tooling caches
*.tsbuildinfo
.eslintcache
coverage/

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Local env / secrets — never commit deployment tokens
.env
.env.*
!.env.example
