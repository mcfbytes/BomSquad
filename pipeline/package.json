{
  "name": "@bomsquad/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Extraction, normalization, coverage and validation pipeline for BOM Squad.",
  "license": "MIT",
  "bin": {
    "pipeline": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx src/cli.ts validate",
    "mame:fetch": "tsx src/cli.ts mame:fetch",
    "mame:extract": "tsx src/cli.ts mame:extract",
    "mame:rows": "tsx src/cli.ts mame:rows",
    "mame:bump-pin": "tsx src/cli.ts mame:bump-pin",
    "mame:refresh-summary": "tsx src/cli.ts mame:refresh-summary",
    "build:db": "tsx src/cli.ts build"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
